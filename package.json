{
  "name": "effectmc-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run @effectmc/docs#dev",
    "build": "vp run @effectmc/vite#build && vp run -r build",
    "preview": "vp run @effectmc/docs#preview",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test",
    "generate:allow-list": "node host/scripts/generate-allow-list.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  }
}
